# Root-owned production Core environment (values are examples only).
# Install as /opt/postersplus/env/postersplus.env with mode 0600.

TMDB_API_KEY=
MDBLIST_API_KEY=
MDBLIST_API_KEY_2=

# Must exactly match POSTERSPLUS_BINGECAT_REQUEST_SECRET in BingeCat.
POSTERSPLUS_BINGECAT_REQUEST_SECRET=
POSTERSPLUS_V2_NONCE_DB_PATH=/app/cache/postersplus_v2_nonces.db

# Optional read-only BingeCat resolver connection. Never point this at a
# writable alternate production database.
BINGECAT_DATABASE_URL=
BINGECAT_ID_RESOLUTION_ENABLED=true
BINGECAT_DB_POOL_MIN=0
BINGECAT_DB_POOL_MAX=5

# The private v2 service is not a CDN. BingeCat owns final immutable WebPs.
CDN_CACHE_TTL=0
WORKERS=1
TEXTLESS_DETECTION_CONCURRENCY=2
TEXTLESS_DETECTION_MAX_VOTES=3000
MDBLIST_CONCURRENCY=3
CACHE_WARM_ENABLED=false

SOURCE_CACHE_MAX_BYTES=15000000000
SOURCE_CACHE_HIGH_WATERMARK_BYTES=13500000000
SOURCE_CACHE_TARGET_BYTES=12000000000
LEGACY_CACHE_MAX_BYTES=5000000000
LEGACY_CACHE_HIGH_WATERMARK_BYTES=4500000000
LEGACY_CACHE_TARGET_BYTES=4000000000
COMPOSITE_CACHE_TTL=604800
COMPOSITE_MAX_ENTRIES=10000

# Optional legacy/public endpoints remain disabled unless explicitly needed.
ACCESS_KEY=
AIOSTREAMS_URL=
AIOSTREAMS_AUTH=
TVDB_API_KEY=
TVDB_SUBSCRIBER_PIN=

# Build-time Compose input, not an application secret.
BAKE_PPOCR_MODEL=true
